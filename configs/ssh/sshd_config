# Cấu hình OpenSSH Server chuẩn
# Vị trí trên Server: /etc/ssh/sshd_config

Port 22
AddressFamily any
ListenAddress 0.0.0.0

# Bảo mật cơ bản
PermitRootLogin no
MaxAuthTries 5
PubkeyAuthentication yes
PasswordAuthentication yes
X11Forwarding no
PrintMotd no
AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/openssh/sftp-server
