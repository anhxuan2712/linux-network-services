; Forward Lookup Zone cho lab.local
; Vị trí trên Server: /etc/bind/zones/db.lab.local
$TTL    604800
@       IN      SOA     ns.lab.local. admin.lab.local. (
                              3         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL
;
; Name Servers
@       IN      NS      ns.lab.local.

; A Records
ns      IN      A       192.168.10.10
server  IN      A       192.168.10.10
web     IN      A       192.168.10.10
